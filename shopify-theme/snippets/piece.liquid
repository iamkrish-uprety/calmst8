{%- comment -%}
  One product with its size picker and Add to bag.
  Usage: {% render 'piece', product: product, heading: 'h3' %}
  Variants are listed directly, so products should have a single option (Size).
  Colour comes from the product metafield custom.colour (single line text).
  For dropshipping, set each variant to "Continue selling when out of stock" or don't track inventory.
  The first product image is shown first (use the flat lay); the second fades in on hover or swipes in on phones.
{%- endcomment -%}
{%- liquid
  assign heading = heading | default: 'h3'
  assign colour = product.metafields.custom.colour.value
-%}
<article class="piece reveal" id="{{ product.handle }}" aria-labelledby="{{ product.handle }}-name">
  <div class="piece-media">
    <div class="piece-img{% if product.images.size > 1 %} has-alt{% endif %}">
      {%- for image in product.images limit: 3 -%}
        {{ image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 960px) 30vw, 90vw', widths: '400, 600, 800, 1000' }}
      {%- endfor -%}
    </div>
    {%- if product.images.size > 1 -%}<p class="swipe-hint label" aria-hidden="true">Swipe for more photos</p>{%- endif -%}
  </div>
  {%- form 'product', product, class: 'piece-tag', novalidate: 'novalidate', data-product-form: '' -%}
    <p class="label">{{ product.type | default: 'CALMST8' | escape }}</p>
    <{{ heading }} id="{{ product.handle }}-name">
      {%- if heading == 'h3' -%}<a href="{{ product.url }}">{{ product.title | escape }}</a>{%- else -%}{{ product.title | escape }}{%- endif -%}
      {%- if colour != blank %} <em>{{ colour | escape }}</em>{% endif -%}
    </{{ heading }}>
    <p class="price">{{ product.price | money }}</p>
    {%- if heading == 'h3' -%}
      <p class="desc">{{ product.description | strip_html | truncatewords: 26 }}</p>
    {%- else -%}
      <div class="desc rte">{{ product.description }}</div>
    {%- endif -%}

    {%- if product.has_only_default_variant -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    {%- else -%}
      {% render 'size-options', product: product %}
    {%- endif -%}
    <p class="size-error" role="alert"></p>
    <button class="add" type="submit" {% unless product.available %}disabled{% endunless %}>
      {%- if product.available -%}Add to bag <span aria-hidden="true">+</span>{%- else -%}Sold out{%- endif -%}
    </button>
  {%- endform -%}
</article>
