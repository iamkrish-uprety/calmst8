<dialog id="fit-dialog" class="info-dialog" aria-labelledby="fit-title">
  <button type="button" class="dialog-close">Close ✕</button>
  <p class="eyebrow">{{ shop.name }} / FIT ASSISTANCE</p>
  <h2 id="fit-title">FIND YOUR FIT.</h2>
  <p>Choose a piece you already own with a fit you love. Lay it flat and measure it without stretching.</p>
  <div class="measure-grid">
    <div>
      <h3>DENIM</h3>
      <p><b>Waist:</b> measure across the waistband, then double it.<br><b>Inside leg:</b> measure from the crotch seam to the hem.</p>
    </div>
    <div>
      <h3>HOODIES &amp; TEES</h3>
      <p><b>Chest:</b> measure across from armpit to armpit.<br><b>Length:</b> measure from the highest shoulder point to the hem.</p>
    </div>
  </div>
  <p class="fit-note">Product-specific measurements are awaiting supplier confirmation. S–XL can vary by style. Contact us for measurements before ordering.</p>
  <a href="https://ig.me/m/calmst8.world" target="_blank" rel="noopener" class="campaign-cta dark">ASK ABOUT SIZING ↗</a>
</dialog>

<dialog id="search-dialog" class="info-dialog" aria-labelledby="search-title">
  <button type="button" class="dialog-close">Close ✕</button>
  <h2 id="search-title">FIND YOUR PIECE.</h2>
  <label for="search-input">Search the collection</label>
  <input id="search-input" type="search" placeholder="Try hoodie, denim or self love" autocomplete="off">
  <div id="search-results" aria-live="polite"></div>
</dialog>
