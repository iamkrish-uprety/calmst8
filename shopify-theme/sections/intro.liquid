<section class="intro" aria-label="About">
  <p class="intro-big">{{ section.settings.big | escape }}<br><em>{{ section.settings.big_italic | escape }}</em></p>
  <p class="intro-small">{{ section.settings.text | escape }}</p>
</section>

{% schema %}
{
  "name": "Statement",
  "settings": [
    { "type": "text", "id": "big", "label": "Heading", "default": "Stay grounded." },
    { "type": "text", "id": "big_italic", "label": "Heading, italic part", "default": "Protect your peace." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "CALMST8 makes streetwear around one idea: stay grounded. Graphic tees, relaxed hoodies and cross-detail denim, designed for everyday wear and made to keep your style effortless and understated." }
  ],
  "presets": [{ "name": "Statement" }]
}
{% endschema %}
