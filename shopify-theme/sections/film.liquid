{%- comment -%}
  Brand film at the top of the page. Muted autoplay (browsers block sound until the visitor asks),
  with Sound and Pause buttons. Upload a new film in Content → Files and pick it here, or the
  built-in film is used.
{%- endcomment -%}
<section class="film" aria-label="{{ shop.name }} film">
  {%- if section.settings.video != blank -%}
    {{ section.settings.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'auto', class: 'film-video', image_size: '1600x' }}
  {%- else -%}
    <video class="film-video" autoplay muted loop playsinline preload="auto" poster="{{ 'calmst8-film-poster.jpg' | asset_url }}">
      <source src="{{ 'calmst8-film.mp4' | asset_url }}" type="video/mp4">
    </video>
  {%- endif -%}
  <div class="film-shade" aria-hidden="true"></div>
  <div class="film-ui">
    <button class="film-btn" type="button" id="film-sound" aria-pressed="false">Sound on</button>
    <button class="film-btn" type="button" id="film-play" aria-pressed="true">Pause</button>
    <a class="film-cue" href="#looks">{{ section.settings.cue | escape }} <span aria-hidden="true">↓</span></a>
  </div>
</section>

{% schema %}
{
  "name": "Film",
  "settings": [
    { "type": "video", "id": "video", "label": "Film", "info": "Landscape (16:9) works best. Leave empty to use the built-in CALMST8 film." },
    { "type": "text", "id": "cue", "label": "Scroll link label", "default": "The collection" }
  ],
  "presets": [{ "name": "Film" }]
}
{% endschema %}
