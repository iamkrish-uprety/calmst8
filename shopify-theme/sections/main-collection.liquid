<section class="shop page-top" id="shop">
  <div class="shop-head">
    <div>
      <p class="label">Collection</p>
      <h2>{{ collection.title | escape }}</h2>
    </div>
  </div>
  {%- paginate collection.products by 24 -%}
    <div class="grid">
      {%- for product in collection.products -%}
        {% render 'card', product: product %}
      {%- else -%}
        <p class="shop-note">There are no pieces in this collection yet.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
  <p class="shop-note">{{ settings.lead_time | escape }}</p>
</section>

{% schema %}
{ "name": "Collection" }
{% endschema %}
