<section class="simple-page">
  <p class="label">{{ shop.name }}</p>
  <h1>Opening soon.</h1>
  {%- if shop.password_message != blank -%}<p class="simple-lead">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'search-form' -%}
    <label class="visually-hidden" for="password">Password</label>
    <input id="password" type="password" name="password" placeholder="Store password" autocomplete="off">
    <button class="button" type="submit">Enter</button>
    {%- if form.errors -%}<p class="size-error">The password is not correct.</p>{%- endif -%}
  {%- endform -%}
</section>

{% schema %}
{ "name": "Password" }
{% endschema %}
