<section class="product-page">
  <div class="product-gallery">
    {%- for media in product.media -%}
      {%- if media.media_type == 'image' -%}
        {%- liquid
          assign loading = 'lazy'
          if forloop.first
            assign loading = 'eager'
          endif
        -%}
        <div class="piece-img">{{ media | image_url: width: 1400 | image_tag: loading: loading, sizes: '(min-width: 960px) 45vw, 92vw', widths: '500, 800, 1100, 1400' }}</div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="product-info">
    <a class="link back" href="{{ routes.root_url }}#shop"><span aria-hidden="true">←</span> Shop all</a>
    {% render 'piece-form', product: product %}
    <p class="index-note">{{ settings.lead_time | escape }}</p>
  </div>
</section>

{% schema %}
{ "name": "Product" }
{% endschema %}
