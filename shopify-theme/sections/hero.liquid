{%- comment -%}
  Hero: the brand film with a campaign headline. Pick a film in the theme editor,
  or the built-in CALMST8 film is used.
{%- endcomment -%}
<section class="hero" aria-labelledby="hero-title-{{ section.id }}">
  {%- if section.settings.video != blank -%}
    {{ section.settings.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'auto', class: 'hero-video', image_size: '1600x' }}
  {%- else -%}
    <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="{{ 'calmst8-film-poster.jpg' | asset_url }}">
      <source src="{{ 'calmst8-film.mp4' | asset_url }}" type="video/mp4">
    </video>
  {%- endif -%}
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-title">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1 id="hero-title-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h1>
    <p>{{ section.settings.text | escape }}</p>
    <a href="#shop" class="campaign-cta">{{ section.settings.button | escape }} <span aria-hidden="true">↗</span></a>
  </div>
  <div class="film-controls">
    <button class="film-btn" type="button" id="film-play" aria-pressed="true">Pause</button>
    <button class="film-btn" type="button" id="film-sound" aria-pressed="false">Sound on</button>
  </div>
</section>

{% schema %}
{
  "name": "Hero film",
  "settings": [
    { "type": "video", "id": "video", "label": "Film", "info": "Landscape (16:9) works best. Leave empty to use the built-in CALMST8 film." },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "THE CALMST8 COLLECTION" },
    { "type": "textarea", "id": "heading", "label": "Headline", "default": "FIND YOUR\nCALM STATE." },
    { "type": "text", "id": "text", "label": "Text", "default": "Streetwear with a purpose. Made for your everyday." },
    { "type": "text", "id": "button", "label": "Button label", "default": "EXPLORE THE COLLECTION" }
  ],
  "presets": [{ "name": "Hero film" }]
}
{% endschema %}
