{%- comment -%}
  Hero: the brand film, full width, muted until the visitor turns the sound on.
  Pick a film in the theme editor, or the built-in CALMST8 film is used.
{%- endcomment -%}
<section class="hero" aria-labelledby="hero-title-{{ section.id }}">
  {%- if section.settings.video != blank -%}
    {{ section.settings.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'auto', class: 'hero-video', image_size: '1600x' }}
  {%- else -%}
    <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="{{ 'calmst8-film-poster.jpg' | asset_url }}">
      <source src="{{ 'calmst8-film.mp4' | asset_url }}" type="video/mp4">
    </video>
  {%- endif -%}
  <div class="hero-shade" aria-hidden="true"></div>
  <h1 class="visually-hidden" id="hero-title-{{ section.id }}">{{ shop.name }}, {{ section.settings.line | escape }}</h1>
  <div class="hero-bar">
    <div>
      <p class="hero-line">{{ section.settings.line | escape }} <em>{{ section.settings.line_italic | escape }}</em></p>
      <p class="hero-sub">{{ section.settings.sub | escape }}</p>
    </div>
    <div class="hero-actions">
      <a class="button" href="#shop">{{ section.settings.button | escape }} <span aria-hidden="true">↓</span></a>
      <button class="film-btn" type="button" id="film-sound" aria-pressed="false">Sound on</button>
      <button class="film-btn" type="button" id="film-play" aria-pressed="true">Pause</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero film",
  "settings": [
    { "type": "video", "id": "video", "label": "Film", "info": "Landscape (16:9) works best. Leave empty to use the built-in CALMST8 film." },
    { "type": "text", "id": "line", "label": "Line", "default": "Considered streetwear." },
    { "type": "text", "id": "line_italic", "label": "Line, italic part", "default": "Calm state." },
    { "type": "text", "id": "sub", "label": "Small print", "default": "Jeans, hoodies and tees · UK delivery £2.99" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Shop the collection" }
  ],
  "presets": [{ "name": "Hero film" }]
}
{% endschema %}
