{%- comment -%} The shop: a filterable product grid. Filters come from each product's Type. {%- endcomment -%}
{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
  assign types = source.products | map: 'type' | uniq
-%}
<section class="shop" id="shop" aria-labelledby="shop-title">
  <div class="shop-head">
    <div>
      <p class="label">{{ section.settings.label | escape }}</p>
      <h2 id="shop-title">{{ section.settings.heading | escape }} {% if section.settings.heading_italic != blank %}<small>{{ section.settings.heading_italic | escape }}</small>{% endif %}</h2>
    </div>
    {%- if types.size > 1 -%}
      <div class="filters" role="group" aria-label="Filter by category" data-filters>
        <button type="button" data-filter="all" aria-pressed="true">All<span class="n">{{ source.products_count }}</span></button>
        {%- for type in types -%}
          {%- if type != blank -%}
            {%- assign count = source.products | where: 'type', type | size -%}
            <button type="button" data-filter="{{ type | handleize }}" aria-pressed="false">{{ type | escape }}{% if type == 'Hoodie' or type == 'T-shirt' %}s{% endif %}<span class="n">{{ count }}</span></button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  <div class="grid">
    {%- for product in source.products limit: section.settings.limit -%}
      {% render 'card', product: product %}
    {%- else -%}
      <p class="shop-note">Add products to your store, then pick their collection in this section’s settings.</p>
    {%- endfor -%}
  </div>
  <p class="shop-note">{{ settings.lead_time | escape }} {{ section.settings.note | escape }}</p>
</section>

{% schema %}
{
  "name": "Shop grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "limit", "label": "Number of products", "min": 1, "max": 24, "step": 1, "default": 12 },
    { "type": "text", "id": "label", "label": "Label", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "THE COLLECTION" },
    { "type": "text", "id": "heading_italic", "label": "Small line under the heading", "default": "01 — EVERYDAY EXPRESSION" },
    { "type": "text", "id": "note", "label": "Note under the grid", "default": "UK delivery £2.99." }
  ],
  "presets": [{ "name": "Shop grid" }]
}
{% endschema %}
