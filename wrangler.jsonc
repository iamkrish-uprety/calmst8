{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calmst8",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    // Public settings. Replace before going live.
    "SITE_URL": "",                          // e.g. https://calmst8.world (blank = use the request origin)
    "OWNER_EMAIL": "owner@example.com",      // gets every order receipt
    "WAREHOUSE_EMAIL": "",                   // set to email the warehouse automatically; blank = owner forwards it
    "FROM_EMAIL": "orders@calmst8.world"     // must be on a domain onboarded to Cloudflare Email Sending
  },
  // Secrets (never in this file): npx wrangler secret put STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
  "send_email": [{ "name": "EMAIL" }],
  "kv_namespaces": [
    // Create with: npx wrangler kv namespace create ORDERS, then paste the id here.
    { "binding": "ORDERS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
}
